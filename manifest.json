{
  "manifest_version": 3,
  "name": "Ambient Light for Bilibili",
  "version": "0.4.1",
  "description": "为哔哩哔哩视频提供正向/交替镜像双模式流光氛围灯，支持环带、模糊、层数与分辨率调节",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/video/*",
        "*://*.bilibili.com/bangumi/play/*",
        "*://*.bilibili.com/blackboard/newplayer.html*"
      ],
      "css": [
        "src/styles/ambient.css"
      ],
      "js": [
        "src/core/renderer.js",
        "src/core/bar-detector.js",
        "src/adapter/bilibili.js",
        "src/ui/panel.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*"
  ]
}
