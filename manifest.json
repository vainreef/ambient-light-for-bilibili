{
  "manifest_version": 3,
  "name": "Ambient Light for Bilibili",
  "version": "0.1.0",
  "description": "为哔哩哔哩（Bilibili）视频提供硬件加速的 WebGL 沉浸式流光氛围灯效果",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/video/*",
        "*://*.bilibili.com/bangumi/play/*",
        "*://*.bilibili.com/blackboard/newplayer.html*"
      ],
      "css": ["src/styles/ambient.css"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.bilibili.com/*"
  ]
}
